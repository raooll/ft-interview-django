# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_DB=ft_interview
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=ft_password
# Change if you already have Postgres on 5432 (e.g. POSTGRES_HOST_PORT=5433).
POSTGRES_HOST_PORT=5432

# ─── Host ports ─────────────────────────────────────────────────────────────
# Change these if 8000 or 3000 are already taken on your machine. Only the
# host side moves — inside the Docker network the services stay on 8000/3000.
# NEXT_PUBLIC_API_URL and CORS_ALLOWED_ORIGINS below follow these by default,
# so you only need to change the port in one place.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ─── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-for-anything-non-local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Defaults to http://localhost:${FRONTEND_HOST_PORT}. Uncomment only to point
# at something other than the frontend container.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Hotel Search ───────────────────────────────────────────────────────────
# 'mock' (default) — in-process fixtures with realistic hotel data for
#                    PAR, LON, NYC, MAD. No credentials needed.
# 'live'           — call the real Amadeus client. NOTE: Amadeus is shutting
#                    down its self-service portal in July 2026; if you have
#                    credentials for an Amadeus-compatible provider, point
#                    AMADEUS_BASE_URL at it.
AMADEUS_MODE=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ─── Frontend ───────────────────────────────────────────────────────────────
# Browser hits this URL. Defaults to http://localhost:${BACKEND_HOST_PORT}, so
# changing BACKEND_HOST_PORT above is enough. Uncomment only to override.
# NEXT_PUBLIC_API_URL=http://localhost:8000
